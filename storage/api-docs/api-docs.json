{
    "openapi": "3.0.0",
    "info": {
        "title": "Account Service API",
        "description": "Dokumentasi API untuk Service 1 - Kelola Akun (Tugas 2 IAE)",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Local Development Server"
        }
    ],
    "paths": {
